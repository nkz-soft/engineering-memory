# engineering-memory — configuration
#
# Copy this file to `.env` and fill in your own values:
#
#     cp .env.example .env
#
# `.env` is ignored by git and must never be committed. This file holds names and explanations
# only — no value here can authenticate against anything, and a test asserts that.
#
# Every variable below is also settable as a real environment variable, which takes precedence
# over this file. That is the way to override one value for a single run without editing anything.
#
# A test keeps this file and the settings object from drifting apart, in both directions: add a
# setting without adding it here and the suite fails.

# --- Hindsight -----------------------------------------------------------------------------
# The self-hosted memory engine (ARCHITECTURE.md §19.3). Required.
ENGINEERING_MEMORY_HINDSIGHT__BASE_URL=

# Bearer token for that instance. Leave unset if your instance runs unauthenticated.
ENGINEERING_MEMORY_HINDSIGHT__TOKEN=

# The single shared memory bank (ADR-002). Defaults to `engineering-global`; set it only to point
# a run at a scratch bank.
#ENGINEERING_MEMORY_HINDSIGHT__BANK_ID=

# --- LLM endpoint --------------------------------------------------------------------------
# The OpenAI-compatible endpoint extraction is routed through — a LiteLLM proxy in this setup
# (ARCHITECTURE.md §19.4). Required. The model itself is proxy configuration, not a setting here.
ENGINEERING_MEMORY_LLM__BASE_URL=

# API key for that endpoint. Leave unset if your proxy accepts unauthenticated calls.
ENGINEERING_MEMORY_LLM__API_KEY=

# --- Logging -------------------------------------------------------------------------------
# Records are JSON, one object per line, on standard error. How much is emitted:
# DEBUG, INFO, WARNING, ERROR or CRITICAL. Defaults to INFO.
#ENGINEERING_MEMORY_LOGGING__LEVEL=

# Permits conversation bodies in log records. Off by default, and worth leaving off: this
# corpus is years of private engineering history, and turning it on puts that text wherever the
# log goes. Set it for one debugging run, not in a file you will forget about.
#
# It never permits a credential — tokens, keys and authorization headers stay redacted whatever
# this is set to.
#ENGINEERING_MEMORY_LOGGING__INCLUDE_CONVERSATION_CONTENT=

# --- Local storage -------------------------------------------------------------------------
# Where originals and normalized conversations are kept (Principle I), and where the importer
# records what it has already imported (ARCHITECTURE.md §17).
#
# A relative path resolves against the repository root, not the working directory, so the same
# value means the same place wherever a command is run from. An installed deployment with no
# repository around it should set absolute paths.
#
# Both default under `data/`, which is ignored by git and never committed.
#ENGINEERING_MEMORY_ARCHIVE_ROOT=
#ENGINEERING_MEMORY_IMPORT_STATE_PATH=

# --- Project rules -------------------------------------------------------------------------
# The alias rules that decide which project a conversation belongs to (ARCHITECTURE.md §15).
# `projects.example.toml` in the repository root documents the format.
#
# Defaults to `data/projects.toml` — under the ignored `data/` on purpose, because this file is
# your project names, your repositories and your local paths, and this repository is public.
#
# Leaving it unset is allowed: with no rules file at the default location the import still runs,
# warns once, and tags everything `project:unknown`. Setting it to a path that does not exist is
# an error — asking for a file and not having one is a different mistake from not asking.
#ENGINEERING_MEMORY_PROJECT_RULES_PATH=
