WORKSTATION_HINDSIGHT_PORT=8888
WORKSTATION_PROXY_PORT=4000
WORKSTATION_PROXY_KEY=replace-with-local-proxy-key
PRODUCT_PROVIDER_MODEL=openai/replace-with-model-name
PRODUCT_PROVIDER_API_KEY=replace-with-provider-key
