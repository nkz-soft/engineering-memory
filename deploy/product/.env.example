# Copy to deploy/product/.env (ignored). Shell variables override the file.
# Required for internal-proxy dependency startup:
PRODUCT_PROXY_KEY=
# LiteLLM provider-qualified model, for example openai/<your-enabled-model>.
PRODUCT_PROVIDER_MODEL=
# A container-reachable OpenAI-compatible provider endpoint, e.g. https://api.openai.com/v1
PRODUCT_PROVIDER_API_BASE=
PRODUCT_PROVIDER_API_KEY=

# Optional: internal alias is fixed to engineering-extraction.
# External proxy mode may select a different alias already configured on that proxy.
# PRODUCT_MODEL_ALIAS=engineering-extraction
# PRODUCT_PROXY_URL=http://host.docker.internal:4000/v1
# PRODUCT_DEV_PORT=8889
